<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rlLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        android:id="@+id/abMain"
        layout="@layout/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true" />

    <!--    <androidx.core.widget.NestedScrollView-->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/abMain"
        android:layout_margin="@dimen/dp5">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/dp10"
            android:gravity="center"
            android:orientation="vertical"
            >

            <TextView
                android:id="@+id/tvCategoryName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp10"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.AppCompat.Widget.ActionBar.Title"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:background="@drawable/btn_shape"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/ivImage"
                        android:layout_width="@dimen/dp60"
                        android:layout_height="@dimen/dp60"
                        android:layout_margin="@dimen/dp5"
                        android:src="@drawable/ic_baseline_linked_camera_24"></ImageView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/dp5"
                        android:gravity="center"
                        android:maxLines="2"
                        android:text="@string/photos"
                        android:textColor="@color/theme3"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:background="@drawable/btn_shape"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/ivVdeo"
                        android:layout_width="@dimen/dp60"
                        android:layout_height="@dimen/dp60"
                        android:layout_margin="@dimen/dp5"
                        android:src="@drawable/ic_baseline_videocam_24"></ImageView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/dp2"
                        android:layout_marginBottom="@dimen/dp5"
                        android:gravity="center"
                        android:maxLines="2"
                        android:text="@string/videos"
                        android:textColor="@color/theme3"
                        android:textSize="8sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dp5"
                android:padding="@dimen/dp5" />

            <RadioGroup
                android:id="@+id/rbGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dp5"
                android:background="@drawable/custom_layout_border_black"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbDene"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp2"
                    android:checked="true"
                    android:text="@string/rentregist">

                </RadioButton>

                <RadioButton
                    android:id="@+id/rbGhene"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp2"
                    android:text="@string/rentrequiremnt">

                </RadioButton>
            </RadioGroup>

            <RadioGroup
                android:id="@+id/rbAVA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dp5"
                android:background="@drawable/custom_layout_border_black"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbAvailable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp2"
                    android:checked="true"
                    android:text="@string/available">

                </RadioButton>

                <RadioButton
                    android:id="@+id/rbNotAva"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp2"
                    android:text="@string/notavailable">

                </RadioButton>
            </RadioGroup>

            <TextView
                android:id="@+id/etCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dp5"
                android:background="@drawable/custom_layout_border_black"
                android:drawableRight="@drawable/ic_baseline_arrow_drop_down_24"
                android:gravity="top|left"
                android:inputType="textMultiLine"
                android:padding="15dp"
                android:text="@string/category"
                android:textColorHint="@color/sub_text_color" />
            <RadioGroup
                android:id="@+id/rbMobile"
                android:layout_margin="@dimen/dp5"
                android:background="@drawable/btn_shape"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rbShow"
                    android:layout_margin="@dimen/dp5"
                    android:text="@string/mobile_show"
                    android:checked="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"></com.google.android.material.radiobutton.MaterialRadioButton>
                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rbHide"
                    android:text="@string/mobile_dont_show"
                    android:layout_margin="@dimen/dp5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"></com.google.android.material.radiobutton.MaterialRadioButton>


            </RadioGroup>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp50"
                android:layout_margin="@dimen/dp5"
                android:background="@drawable/custom_layout_border_black">

                <pl.droidsonroids.gif.GifImageView
                    android:id="@+id/gifTitle"
                    android:layout_width="@dimen/dp25"
                    android:layout_height="match_parent"
                    android:layout_alignParentRight="true"
                    android:src="@drawable/mic" />

                <EditText
                    android:id="@+id/etTitle"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp50"
                    android:background="@null"
                    android:layout_toLeftOf="@+id/gifTitle"
                    android:hint="@string/title"
                    android:inputType="text"
                    android:maxLength="50"
                    android:padding="@dimen/dp5"
                    android:textColor="@color/black"
                    android:textColorHint="@color/sub_text_color"></EditText>


            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dp5"
                android:background="@drawable/custom_layout_border_black">

                <pl.droidsonroids.gif.GifImageView
                    android:id="@+id/gifDescription"
                    android:layout_width="@dimen/dp25"
                    android:layout_height="match_parent"
                    android:layout_alignParentRight="true"
                    android:src="@drawable/mic" />

                <EditText  android:overScrollMode="always"
                    android:scrollbarStyle="insideInset"
                    android:scrollbars="vertical"
                    android:id="@+id/etDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp5"
                    android:layout_toLeftOf="@+id/gifDescription"
                    android:background="@null"
                    android:gravity="top|left"
                    android:hint="@string/description_"
                    android:inputType="textMultiLine"
                    android:maxLength="1000"
                    android:padding="@dimen/dp5"
                    android:textColor="@color/black"
                    android:textColorHint="@color/sub_text_color"></EditText>
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp50"
                android:layout_margin="@dimen/dp5"
                android:background="@drawable/custom_layout_border_black">

                <pl.droidsonroids.gif.GifImageView
                    android:id="@+id/gifPrice"
                    android:layout_width="@dimen/dp25"
                    android:layout_height="match_parent"
                    android:layout_alignParentRight="true"
                    android:src="@drawable/mic" />

                <EditText
                    android:id="@+id/etPrice"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp50"
                    android:layout_margin="@dimen/dp5"
                    android:layout_toLeftOf="@+id/gifPrice"
                    android:background="@null"
                    android:hint="@string/bhadeprice_"
                    android:inputType="number"
                    android:padding="@dimen/dp5"
                    android:textColor="@color/black"
                    android:textColorHint="@color/sub_text_color"></EditText>
            </RelativeLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/etCategoryText"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dp5"
                android:hint="Select Category"
                android:visibility="gone"
                app:startIconDrawable="@drawable/ic_baseline_arrow_drop_down_24"
                app:startIconTint="@color/theme2">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCategory1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="true"
                    android:inputType="text" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dp5"
                android:hint="Title"
                android:textColorHint="@color/theme2"
                android:visibility="gone"
                app:boxStrokeColor="@color/theme2"
                app:hintTextColor="@color/theme2"
                app:startIconDrawable="@drawable/ic_baseline_mic_24"
                app:startIconTint="@color/theme2">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTitle1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>


            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dp5"
                android:hint="Description"
                android:textColorHint="@color/theme2"
                android:visibility="gone"
                app:boxStrokeColor="@color/theme2"
                app:hintTextColor="@color/theme2"
                app:startIconDrawable="@drawable/ic_baseline_mic_24"
                app:startIconTint="@color/theme2">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDescription1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:lines="5"
                    android:maxLength="1000"
                    android:maxLines="15"
                    android:minLines="5" />
            </com.google.android.material.textfield.TextInputLayout>


            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dp5"
                android:hint="Price"
                android:textColorHint="@color/theme2"
                android:visibility="gone"
                app:boxStrokeColor="@color/theme2"
                app:hintTextColor="@color/theme2">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPrice1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:maxLength="10" />
            </com.google.android.material.textfield.TextInputLayout>

            <include layout="@layout/edit_location"/>
            <Button
                android:id="@+id/btnSubmit"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:backgroundTint="@color/theme2"
                android:text="@string/Submit"
                android:textColor="@color/white"
                android:textSize="@dimen/dp20" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <!--    </androidx.core.widget.NestedScrollView>-->


</RelativeLayout>

