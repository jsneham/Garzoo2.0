<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Notification.Fragment.NotificationFragment">

    <androidx.cardview.widget.CardView
        android:layout_alignParentTop="true"
        android:id="@+id/llSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="@dimen/dp10">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:orientation="horizontal">

            <include layout="@layout/search_layout_one"></include>

            <ImageView
                android:id="@+id/ivAdvanceSearch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="0.5"
                android:src="@drawable/ic_baseline_tune_24" />

            <ImageView
                android:id="@+id/ivShare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="0.5"
                android:src="@drawable/ic_baseline_share_24" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/rvNestedScroll"
        android:layout_above="@+id/bannerAdContainer"
        android:background="#eeeeee"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/llSearch">

        <LinearLayout
            android:background="#eeeeee"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <!--            <include layout="@layout/category_layout"></include>-->

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false" />

            <LinearLayout
                android:orientation="vertical"
                android:layout_below="@+id/lltab"
                android:id="@+id/llButton"
                android:gravity="center"
                android:background="@color/view_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:elevation="@dimen/dp10"
                    android:layout_margin="@dimen/dp5"
                    android:padding="@dimen/dp5"
                    android:gravity="center"
                    android:maxLines="3"
                    style="@android:style/Widget.Button"
                    android:backgroundTint="@color/theme2"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_shape"
                    android:id="@+id/btnRegistartaion"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/regestration_one"
                    android:textSize="15sp"></TextView>

                <TextView
                    android:visibility="gone"
                    android:elevation="@dimen/dp10"
                    android:layout_margin="@dimen/dp5"
                    android:padding="@dimen/dp5"
                    android:gravity="center"
                    android:maxLines="3"
                    style="@android:style/Widget.Button"
                    android:backgroundTint="@color/theme2"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_shape"
                    android:id="@+id/btnRequirement"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/btnRequirement"

                    android:textSize="15sp"></TextView>
            </LinearLayout>




            <LinearLayout
                android:id="@+id/view1"
                android:layout_width="match_parent"
                android:layout_height="05dp"
                android:layout_below="@+id/llButton"
                android:background="#eaece9"
                android:orientation="horizontal" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                ></androidx.recyclerview.widget.RecyclerView>
        </LinearLayout>

        <!--        app:layout_behavior="@string/appbar_scrolling_view_behavior"-->
    </androidx.core.widget.NestedScrollView>


</RelativeLayout>