<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center">

    <com.garzoopvt.garzoo.Util.TouchImageView
        android:layout_above="@+id/llroot"
        android:id="@+id/ivImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:src="@drawable/mic_logo"
        app:backgroundTint="?attr/colorControlNormal" />
    <!--    android:scaleType="center"-->

    <LinearLayout
        android:background="@color/theme2"
        android:id="@+id/llroot"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp60"
        android:layout_alignParentBottom="true"
        android:gravity="center">

        <Button
            android:layout_marginRight="@dimen/dp15"
            android:id="@+id/ivDownload"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/btn_shape"
            android:backgroundTint="@color/white"
            android:drawableLeft="@drawable/ic_outline_cloud_download_24"
            android:text="@string/download"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:textSize="13sp">
        </Button>

        <Button
            android:layout_marginRight="@dimen/dp15"
            android:id="@+id/ivShare"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/btn_shape"
            android:backgroundTint="@color/white"
            android:drawableLeft="@drawable/ic_share"
            android:text="@string/share"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:textSize="13sp">

        </Button>
    </LinearLayout>

</RelativeLayout>