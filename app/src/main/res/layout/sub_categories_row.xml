<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/album_item_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/dp2"
    app:cardCornerRadius="@dimen/dp40"
    android:clickable="true"
    android:theme="@style/Theme.MaterialComponents.Light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@color/white"
        android:gravity="center"
        android:orientation="vertical"
        >
        <!--        android:padding="10dp"-->

        <ImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp100"

            ></ImageView>


        <!-- android:src="@drawable/garzoo_logo"           com.github.siyamed.shapeimageview.mask.PorterShape app:siShape="@drawable/shape_rect"-->
        <!--            app:siSquare="true" />-->
        <!--        app:siShape="@drawable/shape_rect"app:siSquare="true"/>-->


        <TextView
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:text="Instagram"
            android:textColor="@color/text_color"
            android:textSize="16sp" />


    </LinearLayout>
</com.google.android.material.card.MaterialCardView>